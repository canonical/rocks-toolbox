#!/bin/sh

# Needs chisel and syft.

set -eux

# DEBUG: temporary, drop before merge.
file --version
syft version
chisel version

STATUS_FILE="$(mktemp)"
ROOTFS="$(mktemp -d)"

install() {
    ./chisel-wrapper --generate-dpkg-status "$STATUS_FILE" -- \
        --release ubuntu-24.04 --root "$ROOTFS" \
        "$@"
}

place_status() {
    mkdir -p "$ROOTFS/var/lib/dpkg"
    cp "$STATUS_FILE" "$ROOTFS/var/lib/dpkg/status"
}

check_syft() {
    local match="$1"
    # DEBUG: temporary, drop before merge.
    cat "$ROOTFS/var/lib/dpkg/status"
    syft "$ROOTFS" -o syft-table || true
    syft "$ROOTFS" -o syft-table -q | grep deb | cut -d' ' -f1  | \
        grep -Pz "$match"
}

cleanup() {
    rm -f "$STATUS_FILE"
}
trap cleanup EXIT

install openssl_bins    # 4 new packages
place_status
check_syft "base-files\nlibc6\nlibssl3t64\nopenssl"

install zlib1g_libs     # 1 more package
place_status
check_syft "base-files\nlibc6\nlibssl3t64\nopenssl\nzlib1g"

install libc6_libs      # no new package
place_status
check_syft "base-files\nlibc6\nlibssl3t64\nopenssl\nzlib1g"
